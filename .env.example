# Copy to .env (already gitignored) and fill in. Every value here is optional -
# the project runs without any of them, at reduced rate or reduced coverage.

# ── 8004scan (AltLayer) ────────────────────────────────────────────────────
# indexer/src/scan8004.ts. Works anonymously at 30 req/min; a key raises the
# tier. The client learns the real limit from X-RateLimit-Limit-Minute and
# paces itself at 90% of it, so this never needs tuning by hand.
SCAN8004_API_KEY=

# Override the learned pace only if you have a reason to.
# SCAN8004_RPM=

# ── BSC RPC ────────────────────────────────────────────────────────────────
# BSC_RPC=https://bsc-dataseed.bnbchain.org
# BSC_ARCHIVE_RPC=

# ── prober (indexer/src/verify.ts) ─────────────────────────────────────────
# How many hosts to work at once. Default 4. Lower it to 1-2 on a slow uplink:
# a starved pool produces timeouts that get recorded as facts about other
# people's agents, which is the bug this default exists to avoid.
# HOST_POOL=4
# PROBE_RETRIES=3

# ── Altana spike (packages/escrow/src/altana-spike.ts) ─────────────────────
# A DISPOSABLE key. Testnet only unless you pass --mainnet.
# ALIVE_KEY=

# ── Advisor model (.agents/scripts/ask-nvidia.mjs) ─────────────────────────
# NVIDIA hosts kimi-k3 and others free at the tier this needs. The script
# reads the key from here or from the environment and never prints it.
# Get one at https://build.nvidia.com
NVIDIA_API_KEY=
